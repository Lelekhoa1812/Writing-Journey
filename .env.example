# NVIDIA NIM keys. Numbered slots load after NVIDIA_NIM_API_KEYS.
# The app rotates these keys. It never prints them.
NVIDIA_NIM_API_KEY_1=
NVIDIA_NIM_API_KEY_2=
NVIDIA_NIM_API_KEY_3=
NVIDIA_NIM_API_KEY_4=
NVIDIA_NIM_API_KEY_5=
NVIDIA_NIM_API_KEY_6=
NVIDIA_NIM_API_KEY_7=
NVIDIA_NIM_API_KEY_8=
NVIDIA_NIM_API_KEY_9=

# Optional comma-separated list. These keys load first.
# NVIDIA_NIM_API_KEYS=

# Optional timeout for one model attempt, in milliseconds.
# NIM_TIMEOUT_MS=90000
